# Khushi Gaming Zone — Environment Configuration
# Copy this to .env.local

# Database (Neon Postgres connection string)
DATABASE_URL="postgres://postgres:password@localhost:5432/khushigamingzone"

# Auth & Security
JWT_SECRET="khushi-gaming-zone-super-secret-jwt-key-min-32-chars-long!"
CRON_SECRET="khushi-cron-secret-change-me"
APP_URL="http://localhost:3000"

# Pluggable Providers (mock | msg91 | meta | interakt | razorpay)
OTP_PROVIDER="mock"
WHATSAPP_PROVIDER="mock"
PAYMENT_PROVIDER="mock"

# Cloudinary (Optional in mock mode)
CLOUDINARY_CLOUD_NAME="demo"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="mock_cloudinary_secret"

# Razorpay (Optional in mock mode)
RAZORPAY_KEY_ID="rzp_test_mock123"
RAZORPAY_KEY_SECRET="mock_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="mock_razorpay_webhook_secret"

# SMS & WhatsApp (Optional in mock mode)
MSG91_AUTH_KEY="mock_msg91_key"
WHATSAPP_API_KEY="mock_whatsapp_key"

